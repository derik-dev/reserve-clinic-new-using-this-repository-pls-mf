# Copy this file to .env.local and fill the values for the services you use.
# Never commit real secrets or service-role keys.

# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reserve-clinic-backup
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Firebase SQL Connect / Data Connect
NEXT_PUBLIC_FIREBASE_DATACONNECT_SERVICE_ID=reserve-clinic
NEXT_PUBLIC_FIREBASE_DATACONNECT_LOCATION=us-east4
NEXT_PUBLIC_FIREBASE_DATACONNECT_CONNECTOR=reserve_clinic

# Supabase legacy variables kept while the UI migration is in progress.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Z-API (WhatsApp)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Payments and notifications
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
DISCORD_WEBHOOK_URL=

# Webhooks (obrigatórios: sem o segredo o webhook correspondente responde 503)
# ASAAS_WEBHOOK_TOKEN também é exigido por /api/conectar-asaas.
MP_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=

# Saques (opcional): chave Pix padrão do servidor
ASAAS_TRANSFER_PIX_KEY=
ASAAS_TRANSFER_PIX_KEY_TYPE=

# Só use em staging: libera /api/simular-pagamento em produção
# ENABLE_PAYMENT_SIMULATION=true

# Limpeza diária de reservas não pagas (Vercel Cron envia como "Authorization: Bearer <valor>")
CRON_SECRET=
