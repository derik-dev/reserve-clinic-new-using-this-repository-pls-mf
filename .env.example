# Copy this file to .env.local and fill the values for the services you use.
# Never commit real secrets or service-role keys.

# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reserve-clinic-backup
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Firebase SQL Connect / Data Connect
NEXT_PUBLIC_FIREBASE_DATACONNECT_SERVICE_ID=reserve-clinic
NEXT_PUBLIC_FIREBASE_DATACONNECT_LOCATION=us-east4
NEXT_PUBLIC_FIREBASE_DATACONNECT_CONNECTOR=reserve_clinic

# Supabase legacy variables kept while the UI migration is in progress.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Z-API (WhatsApp)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Payments and notifications
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
DISCORD_WEBHOOK_URL=
